# PostgreSQL。docker compose の既定値
DATABASE_URL=postgres://postgres:postgres@localhost:5433/enje_development

# 管理系エンドポイント（再検証の手動実行など）の Bearer トークン
ADMIN_API_TOKEN=change-me

# 本番のみ必須。`bin/rails secret` で生成する
SECRET_KEY_BASE=

# Next.js の URL と、ISR 再検証に使う共有秘密。frontend と同じ値にする
FRONTEND_URL=http://localhost:3001
REVALIDATE_SECRET=change-me

# お問い合わせの送信先と Resend の API キー。両方揃うまでお問い合わせ API は 503 を返す
CONTACT_TO=
RESEND_API_KEY=

# 追加で許可する CORS オリジン（カンマ区切り、通常は不要）
CORS_ORIGINS=
